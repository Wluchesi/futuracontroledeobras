generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id           String        @id @default(uuid())
  name         String
  taxId        String?
  planName     String        @default("Premium Multi-Obras")
  maxProjects  Int           @default(10)
  maxUsers     Int           @default(20)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  projects     Project[]
  suppliers    Supplier[]
  bankAccounts BankAccount[]
}

model User {
  id           String     @id @default(uuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("ADMIN") // ADMIN, ENGENHEIRO, COMPRADOR, FINANCEIRO
  avatarUrl    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Project {
  id                   String           @id @default(uuid())
  companyId            String
  company              Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                 String
  ownerClient          String
  address              String
  city                 String
  state                String
  startDate            DateTime
  endDate              DateTime
  landArea             Float            @default(0)
  builtArea            Float            @default(0)
  unitsCount           Int              @default(1)
  description          String?
  status               String           @default("EM_ANDAMENTO") // PLANEJAMENTO, EM_ANDAMENTO, PAUSADA, CONCLUIDA, CANCELADA
  exceedRule           Int              @default(1) // 1 = ALERT, 2 = CONFIRM, 3 = BLOCK
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  budgetItems          BudgetItem[]
  quotations           Quotation[]
  purchases            Purchase[]
  accountsPayable      AccountPayable[]
}

model CostCenter {
  id              String           @id @default(uuid())
  code            String           @unique // 01 a 26
  name            String
  category        String           @default("Geral")
  description     String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  budgetItems     BudgetItem[]
  purchases       Purchase[]
  accountsPayable AccountPayable[]
}

model Supplier {
  id              String           @id @default(uuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  corporateName   String           // Razão Social
  tradeName       String?          // Nome Fantasia
  taxId           String?          // CNPJ ou CPF
  contactPerson   String?
  phone           String?
  whatsapp        String?
  email           String?
  address         String?
  city            String?
  state           String?
  supplierType    String           @default("MATERIAL") // MATERIAL, MAO_DE_OBRA, SERVICO, EQUIPAMENTO, PROJETO, FRETE, OUTROS
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  quotations      Quotation[]
  purchases       Purchase[]
  accountsPayable AccountPayable[]
  chosenInItems   BudgetItem[]     @relation("ChosenSupplier")
}

model BudgetItem {
  id                   String           @id @default(uuid())
  projectId            String
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCenterId         String
  costCenter           CostCenter       @relation(fields: [costCenterId], references: [id])
  code                 String           // ex: ORC-0001
  stage                String           // Etapa ex: "05. Fundações"
  itemName             String           // Serviço/Item
  description          String?
  unit                 String           // m², m³, un, kg, verba, hrs, etc.
  quantity             Float            @default(0)
  chosenSupplierId     String?
  chosenSupplier       Supplier?        @relation("ChosenSupplier", fields: [chosenSupplierId], references: [id])
  contractedUnitPrice  Float            @default(0)
  contractedTotal      Float            @default(0)
  purchasedTotal       Float            @default(0)
  paidTotal            Float            @default(0)
  balance              Float            @default(0)
  status               String           @default("PLANEJADO") // PLANEJADO, COTACAO, CONTRATADO, EM_ANDAMENTO, CONCLUIDO
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  quotations           Quotation[]
  purchases            Purchase[]
}

model Quotation {
  id             String      @id @default(uuid())
  budgetItemId   String
  budgetItem     BudgetItem  @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  date           DateTime    @default(now())
  validityDate   DateTime?
  quantity       Float       @default(0)
  unitPrice      Float       @default(0)
  freight        Float       @default(0)
  discount       Float       @default(0)
  taxes          Float       @default(0)
  finalPrice     Float       @default(0)
  deliveryDays   Int         @default(0)
  paymentTerms   String?
  notes          String?
  attachmentUrl  String?
  isChosen       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Purchase {
  id               String           @id @default(uuid())
  purchaseNumber   String           // COMP-0001
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCenterId     String
  costCenter       CostCenter       @relation(fields: [costCenterId], references: [id])
  budgetItemId     String
  budgetItem       BudgetItem       @relation(fields: [budgetItemId], references: [id])
  supplierId       String
  supplier         Supplier         @relation(fields: [supplierId], references: [id])
  date             DateTime         @default(now())
  invoiceNumber    String?          // NF / Recibo
  description      String
  quantity         Float            @default(1)
  unit             String           @default("un")
  unitPrice        Float            @default(0)
  discount         Float            @default(0)
  freight          Float            @default(0)
  totalAmount      Float            @default(0)
  paymentCondition String?
  dueDate          DateTime
  notes            String?
  attachmentUrl    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  accountsPayable  AccountPayable[]
}

model AccountPayable {
  id              String      @id @default(uuid())
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCenterId    String
  costCenter      CostCenter  @relation(fields: [costCenterId], references: [id])
  purchaseId      String?
  purchase        Purchase?   @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  supplierId      String
  supplier        Supplier    @relation(fields: [supplierId], references: [id])
  documentNumber  String?
  description     String
  amount          Float       @default(0)
  issueDate       DateTime    @default(now())
  dueDate         DateTime
  paymentDate     DateTime?
  paymentMethod   String?     // PIX, BOLETO, TRANSFERENCIA, CARTAO, DINHEIRO
  bankAccountId   String?
  bankAccount     BankAccount? @relation(fields: [bankAccountId], references: [id])
  status          String      @default("A_VENCER") // PAGO, A_VENCER, VENCIDO
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  payments        Payment[]
}

model Payment {
  id                   String         @id @default(uuid())
  accountPayableId     String
  accountPayable       AccountPayable @relation(fields: [accountPayableId], references: [id], onDelete: Cascade)
  amountPaid           Float          @default(0)
  paymentDate          DateTime       @default(now())
  paymentMethod        String         @default("PIX")
  receiptAttachmentUrl String?
  notes                String?
  createdAt            DateTime       @default(now())
}

model BankAccount {
  id              String           @id @default(uuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankName        String
  accountNumber   String
  agency          String
  initialBalance  Float            @default(0)
  currentBalance  Float            @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accountsPayable AccountPayable[]
}

model Attachment {
  id         String   @id @default(uuid())
  entityType String   // QUOTATION, PURCHASE, PAYABLE, PROJECT
  entityId   String
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  createdAt  DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName      String   @default("Sistema")
  action        String   // CREATE, UPDATE, DELETE
  entityName    String
  entityId      String
  previousValue String?  // JSON string
  newValue      String?  // JSON string
  details       String?
  createdAt     DateTime @default(now())
}

model SinapiItem {
  id            String   @id @default(uuid())
  codigoSinapi  String           // Código SINAPI oficial (ex: "00000370")
  descricao     String           // Descrição do insumo
  unidade       String           // Unidade (KG, M3, M2, UN, SC, L, etc.)
  precoMediano  Float            // Preço mediano de referência
  categoria     String           // MATERIAL, MAO_DE_OBRA, EQUIPAMENTO, COMPOSICAO
  grupo         String           // Grupo funcional (Fundações, Alvenaria, Elétrica, etc.)
  uf            String   @default("MG")       // Estado de referência
  mesReferencia String   @default("08/2024")  // Mês/Ano da tabela
  tipo          String   @default("NAO_DESONERADO") // DESONERADO ou NAO_DESONERADO
  createdAt     DateTime @default(now())
}
